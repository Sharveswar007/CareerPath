# ==========================================
# CareerPath Environment Variables Template
# Copy this file to .env.local and fill in your values
# ==========================================

# Supabase Configuration (Required)
# Found in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Groq Cloud API Key (only needed if AI_BASE_URL is NOT set - acts as cloud fallback)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Self-hosted vLLM (OpenAI-compatible). When AI_BASE_URL is set, ALL AI calls go to your GPU server.
# Example for Cloudflare Tunnel: https://vllm.yourdomain.com/v1
AI_API_KEY=
AI_BASE_URL=
# Must match --served-model-name on the vLLM container
AI_MODEL=careerpath-ai

# Tavily API Key (Optional: for career trends enrichment)
# Get from: https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_key_here

# Judge0 Execution URL (Optional: defaults to Wandbox if empty or unreachable)
# If self-hosting Judge0 via Docker, use: http://localhost:2358
JUDGE0_URL=http://localhost:2358
# Auth token for self-hosted Judge0 (must match AUTHN_TOKEN in server/judge0/judge0.conf).
# Required whenever JUDGE0_URL points at your own Judge0 instance (local or tunnel).
JUDGE0_AUTH_TOKEN=

# OCR.space API Key (Optional: fallback OCR for image-heavy resumes)
# OCR_SPACE_API_KEY=your_ocr_space_api_key_here
