# Tracked TEMPLATE (secret-free). The setup wizard copies it to .env.local when
# no .env.campus exists at the repo root. Real/rotated values stay in the
# gitignored .env.campus.local - never commit real tokens or keys.
#
# SINGLE-PORT CAMPUS MODE:
#   Students open ONE url only:  http://<server-ip>:3000  (or on mobile data /
#   another IP - it keeps working, because nothing below contains an IP).
#   The server LAN IP can change any time (WiFi/DHCP) and the app does not
#   care - no rebuild is ever needed for IP changes.
# ==========================================================
# CareerPath - CAMPUS MODE (all services on the college server)
# ==========================================================

# Relative browser-side URL: proxied to the real gateway by next.config.ts
# rewrites (path /supa/*). Students reach everything through the app port -
# no other port is ever exposed to them.
NEXT_PUBLIC_SUPABASE_URL=/supa
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_FROM_SERVER_SUPABASE_DOTENV_ANON_KEY

# The Next.js SERVER talks to the gateway directly on localhost. Node fetch
# cannot use relative URLs, so server code (API routes, middleware) needs this.
# Keep the port in sync with API_GW_HTTP_PORT in server/supabase/docker/.env.
SUPABASE_INTERNAL_URL=http://localhost:54321

# Server-only services (called by the Next.js server itself, localhost is correct)
AI_BASE_URL=http://localhost:8001
# PRIVATE VALUES: place the repo-root .env.campus.local (NEVER commit it) and run
# server\campus-setup.ps1 - it fills this line and the Judge0 token from the cred file.
# Without it, keep the placeholder: vLLM reads AI_API_KEY from this file too, so
# key and app stay consistent.
AI_API_KEY=campus-local-please-rotate-me
AI_MODEL=careerpath-ai
AI_TIMEOUT_MS=120000

JUDGE0_URL=http://localhost:2358
# Must stay IDENTICAL to AUTHN_TOKEN in server\judge0\judge0.conf
JUDGE0_AUTH_TOKEN=campus-local-please-rotate-me

# SERVER-ONLY (bypasses RLS; powers /privacy account deletion).
# From server/supabase/docker/.env -> line SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=PASTE_FROM_SERVER_SUPABASE_DOTENV_SERVICE_ROLE_KEY

# ---- Optional extras (safe to leave empty) ----
# Groq cloud fallback (used only if AI_BASE_URL is removed/empty)
GROQ_API_KEY=dummy_not_used
# Career trends enrichment (free tier; app falls back to AI without it)
TAVILY_API_KEY=
# OCR fallback for scanned resumes (app degrades gracefully without it)
# OCR_SPACE_API_KEY=
